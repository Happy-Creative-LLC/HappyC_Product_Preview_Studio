# Copy this file to .env (git bỏ qua .env) rồi điền giá trị thật. Không commit secret.
# Backend đọc .env khi chạy từ thư mục gốc hoặc backend/.

# --- Bắt buộc ---
# Khoá ký JWT (HS512): tối thiểu 64 ký tự. Thiếu hoặc quá ngắn thì backend không khởi động.
# Tạo nhanh: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# --- Database (mặc định khớp docker-compose.yml) ---
# DB_USER=dev
# DB_PASS=dev123
# Nếu DB không chạy ở localhost:5432/productpreview:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/productpreview

# --- Seed user dev (chỉ khi chạy profile dev: SPRING_PROFILES_ACTIVE=dev) ---
# Mật khẩu chung cho 10 tài khoản dev, từ 8 ký tự, tối đa 72 byte. Không dùng ở production.
# DEV_SEED_PASSWORD=

# --- Amazon Search (RapidAPI) ---
RAPIDAPI_AMAZON_KEY=
RAPIDAPI_AMAZON_HOST=real-time-amazon-data.p.rapidapi.com

# --- Đăng nhập Google (tuỳ chọn) ---
# GOOGLE_CLIENT_ID=

# --- Lưu file: db (mặc định) | r2 | local ---
# STORAGE_PROVIDER=db
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
